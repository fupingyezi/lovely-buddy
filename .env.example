DEEPSEEK_API_KEY=
# SiliconFlow（BGE-M3 embedding，有免费额度）：https://siliconflow.cn
SILICONFLOW_API_KEY=
# 阿里 DashScope（备用对话/embedding）：https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=

# ===== 开发环境 =====
# 开发模式前后端通信 token（打包模式下由应用每次启动随机生成）
