# ===== 模型 API Key（按需填写，默认对话走 DeepSeek）=====
# DeepSeek：https://platform.deepseek.com
DEEPSEEK_API_KEY=
# 智谱（GLM 对话/embedding-3，OpenAI 兼容）：https://open.bigmodel.cn
ZHIPU_API_KEY=
# 阿里 DashScope（备用对话/embedding）：https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=
# 月之暗面 Kimi（备用对话）：https://platform.moonshot.cn
MOONSHOT_API_KEY=

# ===== 对话模型（M2）=====
# 厂商：deepseek（默认）| dashscope | zhipu | moonshot；不填走默认。
# 已在设置·模型与连接里保存连接时，界面配置接管、本文件不生效
# LOVELYBUDDY_CHAT_PROVIDER=deepseek
# 模型：不填用厂商默认（deepseek-chat / qwen-plus）
# LOVELYBUDDY_CHAT_MODEL=deepseek-chat
# 自定义 OpenAI 兼容端点（如本地 vLLM），不填用厂商默认地址
# LOVELYBUDDY_CHAT_BASE_URL=

# ===== 开发环境 =====
# 开发模式前后端通信 token（打包模式下由应用每次启动随机生成）
LOVELYBUDDY_DEV_TOKEN=dev
